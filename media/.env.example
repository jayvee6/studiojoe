# Copy to media/.env and fill in. media/.env is gitignored — never commit it.
#
# Cloudflare dashboard → R2 → Overview: the Account ID is in the right-hand panel.
R2_ACCOUNT_ID=
R2_BUCKET=studiojoe-media

# Bump this when you re-encode assets. Objects are served with a 1-year immutable
# cache, so a new prefix is the cache-buster. Must match MEDIA_BASE in the page.
MEDIA_VERSION=v1

# --- rclone path (preferred: incremental uploads) ---
# R2 → Manage API Tokens → Create API Token → Object Read & Write, scoped to the bucket.
# That screen gives you an S3-compatible Access Key ID + Secret.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- wrangler fallback (used only when rclone is not installed) ---
# My Profile → API Tokens → Create Token, with Workers R2 Storage: Edit.
CLOUDFLARE_API_TOKEN=
